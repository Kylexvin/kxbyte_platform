// src/database/postgres/prisma/verticals/pharmacy/config.prisma

// ============================================================
// KXTILL PHARMACY - VERTICAL CONFIGURATION
// Belongs to a ProductInstance (vertical = "pharmacy"),
// NOT directly to an organization.
// ============================================================

model KxTillPharmacyConfig {
  id                String          @id @default(uuid())
  productInstanceId String          @unique
  productInstance   ProductInstance @relation(fields: [productInstanceId], references: [id], onDelete: Cascade)

  isEnabled             Boolean @default(true)
  expiryWarningDays     Int     @default(90)
  blockExpiredSales     Boolean @default(true)
  requireBatchOnSale    Boolean @default(true)
  defaultDispensingUnit String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kxtill_pharmacy_config")
}