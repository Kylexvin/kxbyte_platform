// src/database/postgres/prisma/verticals/pharmacy/batch.prisma

// ============================================================
// KXTILL PHARMACY - BATCH IDENTITY + BRANCH STOCK
// ============================================================

model KxTillPharmacyBatch {
  id        String        @id @default(uuid())
  productId String
  product   KxTillProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNumber    String
  expiryDate     DateTime
  manufacturedAt DateTime?
  manufacturer   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks          KxTillPharmacyBatchStock[]
  saleAllocations KxTillPharmacySaleBatchAllocation[]
  movements       KxTillPharmacyStockMovement[]

  @@unique([productId, batchNumber, expiryDate])
  @@index([productId])
  @@index([expiryDate])
  @@map("kxtill_pharmacy_batches")
}

model KxTillPharmacyBatchStock {
  id              String              @id @default(uuid())
  batchId         String
  batch           KxTillPharmacyBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  branchProductId String
  branchProduct   KxTillBranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)

  quantityOnHand Decimal  @default(0)
  unitCost       Decimal  @default(0)
  sellingPrice   Decimal?
  status         String   @default("AVAILABLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleAllocations KxTillPharmacySaleBatchAllocation[]
  movements       KxTillPharmacyStockMovement[]

  @@unique([batchId, branchProductId])
  @@index([branchProductId])
  @@index([status])
  @@map("kxtill_pharmacy_batch_stock")
}