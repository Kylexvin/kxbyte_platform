generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberships        Membership[]
  sentInvitations    Invitation[] @relation("InvitationSender")

  sessions          Session[]
  verificationTokens VerificationToken[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  kxtillSales       KxTillSale[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  socialAccounts    SocialAccount[]

  // ✅ Add this
  refundedSales     KxTillSale[] @relation("RefundedByUser")

  @@map("users")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken  String    @unique
  expiresAt     DateTime
  userAgent     String?
  ipAddress     String?
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("sessions")
}

model VerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  type        String    // EMAIL_VERIFICATION, PASSWORD_RESET
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("verification_tokens")
}

// ============================================================
// ORGANIZATIONS & MEMBERSHIPS
// ============================================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  logo        String?
  email       String?
  phone       String?
  address     String?
  country     String
  currency    String   @default("KES")
  timezone    String   @default("Africa/Nairobi")
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  organizationProducts OrganizationProduct[]
  roles        Role[]
  subscriptions Subscription[]
  auditEvents  AuditEvent[]
  notifications Notification[]
  paymentConfig PaymentMerchantConfig?
  paymentTransactions PaymentTransaction[]
  paymentIPNRegistrations PaymentIPNRegistration[]
  kxtillProducts    KxTillProduct[]
  kxtillSales       KxTillSale[]
  kxtillStoreSetting KxTillStoreSetting?
  branches       Branch[]
  supportTickets SupportTicket[]

  @@index([ownerId])
  @@index([slug])
  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?    @relation(fields: [roleId], references: [id])  // ← add this
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hasAllBranches Boolean  @default(false)
  branchAssignments BranchAssignment[]


  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ============================================================
// INVITATIONS
// ============================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invitation {
  id             String   @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  roleId         String?
  token          String   @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// PRODUCTS & ORGANIZATION PRODUCTS
// ============================================================

model Product {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  version     String   @default("1.0.0")
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationProducts OrganizationProduct[]

  @@map("products")
}

model OrganizationProduct {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  activatedAt    DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@index([productId])
  @@map("organization_products")
}

// ============================================================
// AUTHORIZATION
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  productKey  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([productKey])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================================
// SUBSCRIPTIONS & PLANS
// ============================================================

model Plan {
  id          String          @id @default(uuid())
  productKey  String
  key         String          // "professional", "business"
  name        String
  price       Int             // Whole currency amount: 699 = KES 699
  currency    String          @default("KES")
  interval    BillingInterval @default(MONTHLY)
  trialDays   Int             @default(21)
  features    String[]        // ["sales", "inventory"]
  limits      Json?           // { "users": 5, "products": 5000 }
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions Subscription[]

  @@unique([productKey, key])
  @@index([productKey])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productKey           String
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIAL)

  trialStart           DateTime?
  trialEnd             DateTime?
  graceStart           DateTime?
  graceEnd             DateTime?

  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime

  cancelledAt          DateTime?
  expiredAt            DateTime?

  // ✅ Add this field
  metadata             Json?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments             Payment[]

  @@unique([organizationId, productKey])
  @@index([organizationId])
  @@index([productKey])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount         Int           // Whole currency amount: 699 = KES 699
  currency       String        @default("KES")
  status         PaymentStatus
  method         String?       // mpesa, card, bank
  reference      String?
  metadata       Json?
  paidAt         DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_events")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  message        String
  channel        NotificationChannel @default(IN_APP)
  productKey     String?
  resource       String?
  resourceId     String?
  metadata       Json?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// PAYMENTS
// ============================================================

model PaymentMerchantConfig {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  provider        String   @default("PESAPAL")
  environment     String   // SANDBOX | LIVE
  consumerKey     String
  consumerSecret  String   // ENCRYPTED
  isActive        Boolean  @default(true)
  lastTestedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payment_merchant_configs")
}

model PaymentTransaction {
  id                  String   @id @default(uuid())
  organizationId      String
  productId           String?
  productReference    String?
  provider            String   @default("PESAPAL")
  merchantReference   String   @unique
  orderTrackingId     String?
  confirmationCode    String?
  amount              Decimal
  currency            String   @default("KES")
  description         String?
  status              String   @default("PENDING")
  paymentMethod       String?
  paymentAccount      String?
  redirectUrl         String?
  callbackUrl         String?
  cancellationUrl     String?
  notificationId      String?
  billingEmail        String?
  billingPhone        String?
  billingFirstName    String?
  billingLastName     String?
  billingCountry      String?
  billingLine1        String?
  billingCity         String?
  billingState        String?
  metadata            Json?
  ipnReceived         Boolean  @default(false)
  ipnPayload          Json?
  statusCode          Int?
  statusDescription   String?
  createdDate         DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderTrackingId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentIPNRegistration {
  id                String   @id @default(uuid())
  organizationId    String
  provider          String   @default("PESAPAL")
  ipnId             String
  url               String
  notificationType  String   // GET | POST
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, ipnId])
  @@index([organizationId])
  @@map("payment_ipn_registrations")
}


// ============================================================
// KXTILL - PRODUCTS, UNITS, PRICING & INVENTORY
// ============================================================

model KxTillProduct {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  category       String?
  taxRate        Decimal  @default(0)
  isActive       Boolean  @default(true)
  trackInventory Boolean  @default(true)

  baseUnitId     String?  @unique
  baseUnit       KxTillProductUnit? @relation("KxTillBaseUnit", fields: [baseUnitId], references: [id])
  units          KxTillProductUnit[] @relation("KxTillProductUnits")

  branchProducts KxTillBranchProduct[]
  saleItems      KxTillSaleItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([sku])
  @@map("kxtill_products")
}


// ============================================================
// KXTILL - BRANCH PRODUCTS & INVENTORY
// ============================================================

model KxTillBranchProduct {
  id             String   @id @default(uuid())
  productId      String
  product        KxTillProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  displayName    String?
  description    String?
  isAvailable    Boolean  @default(true)
  stock          Decimal  @default(0)
  minStock       Decimal  @default(0)

  unitPrices     KxTillBranchProductUnitPrice[]
  saleItems      KxTillSaleItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@map("kxtill_branch_products")
}

// ============================================================
// KXTILL - BRANCH PRODUCT UNIT PRICES
// ============================================================

model KxTillBranchProductUnitPrice {
  id               String   @id @default(uuid())
  branchProductId  String
  branchProduct    KxTillBranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
  unitId           String
  unit             KxTillProductUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  price            Decimal

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([branchProductId, unitId])
  @@index([branchProductId])
  @@index([unitId])
  @@map("kxtill_branch_product_unit_prices")
}
// ============================================================
// KXTILL - PRODUCT UNITS
// ============================================================

model KxTillProductUnit {
  id               String   @id @default(uuid())
  productId        String
  product          KxTillProduct @relation("KxTillProductUnits", fields: [productId], references: [id], onDelete: Cascade)
  name             String
  abbreviation     String
  unitType         String
  conversionQty    Decimal  @default(1)
  price            Decimal?
  allowFractional  Boolean  @default(false)
  barcode          String?
  isBaseUnit       Boolean  @default(false)
  baseForProduct   KxTillProduct? @relation("KxTillBaseUnit")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  saleItems        KxTillSaleItem[]
  branchUnitPrices KxTillBranchProductUnitPrice[]

  @@unique([productId, name])
  @@unique([productId, abbreviation])
  @@index([productId])
  @@map("kxtill_product_units")
}

// ============================================================
// KXTILL - SALES
// ============================================================

model KxTillSale {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  reference      String?
  customerName   String?

  refundedBy     String?
  refundedByUser User?    @relation("RefundedByUser", fields: [refundedBy], references: [id], onDelete: SetNull)  // ← Add this
  refundedAt     DateTime?

  subtotal       Decimal
  taxAmount      Decimal  @default(0)
  discount       Decimal  @default(0)
  totalAmount    Decimal
  status         String   @default("COMPLETED")
  paymentStatus  String   @default("PAID")

  items          KxTillSaleItem[]
  payments       KxTillSalePayment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([reference])
  @@map("kxtill_sales")
}

// ============================================================
// KXTILL - SALE ITEMS
// ============================================================

model KxTillSaleItem {
  id             String   @id @default(uuid())
  saleId         String
  sale           KxTillSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId      String
  product        KxTillProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  // ✅ Required
  branchProductId String
  branchProduct   KxTillBranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Restrict)

  unitId         String
  unit           KxTillProductUnit @relation(fields: [unitId], references: [id])

  // Historical snapshots
  unitName       String
  unitAbbrev     String
  unitType       String
  quantity       Decimal
  conversionQty  Decimal
  unitPrice      Decimal
  baseQuantity   Decimal

  taxRate        Decimal  @default(0)
  taxAmount      Decimal  @default(0)
  discount       Decimal  @default(0)
  total          Decimal

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([branchProductId])
  @@index([unitId])
  @@map("kxtill_sale_items")
}

// ============================================================
// KXTILL - SALE PAYMENTS
// ============================================================

model KxTillSalePayment {
  id             String   @id @default(uuid())

  saleId         String
  sale            KxTillSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // CASH, MPESA, CARD, BANK, OTHER
  method         String

  amount         Decimal

  // M-Pesa receipt, card reference, bank reference, etc.
  reference      String?

  metadata       Json?

  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([method])
  @@map("kxtill_sale_payments")
}



// ============================================================
// KXTILL - STORE SETTINGS
// ============================================================

model KxTillStoreSetting {
  id             String   @id @default(uuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  shopName       String?
  shopPhone      String?
  shopAddress    String?
  shopEmail      String?
  taxNumber      String?

  receiptFooter  String?
  receiptHeader  String?

  showTax        Boolean  @default(false)
  showCustomer   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("kxtill_store_settings")
}

// ============================================================
// BRANCH MANAGEMENT
// ============================================================

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  code           String
  address        String?
  phone          String?
  email          String?

  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)

  assignments    BranchAssignment[]
  sales          KxTillSale[]
  branchProducts KxTillBranchProduct[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

model BranchAssignment {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([membershipId, branchId])
  @@index([membershipId])
  @@index([branchId])
  @@map("branch_assignments")
}

// ============================================================
// SUPPORT - TICKETS & CATEGORIES
// ============================================================

model SupportCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     SupportTicket[]

  @@map("support_categories")
}

model SupportTicket {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId     String
  category       SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title          String
  description    String
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String   @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  productKey     String?  // kxtill, kxinvoice, etc.

  messages       SupportMessage[]

  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@index([productKey])
  @@map("support_tickets")
}

model SupportMessage {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String
  isInternal     Boolean  @default(false)
  attachments    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticketId])
  @@map("support_messages")
}
// ============================================================
// SOCIAL AUTH
// ============================================================

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // google, github, apple, facebook
  providerId  String
  email       String?
  name        String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
  @@map("social_accounts")
}