generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberships        Membership[]
  sentInvitations    Invitation[] @relation("InvitationSender")

  authoredSupportGuides SupportGuide[] @relation("GuideAuthor")

  sessions          Session[]
  verificationTokens VerificationToken[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  kxtillSales       KxTillSale[] 
  supportMessages   SupportMessage[]
  socialAccounts    SocialAccount[]

  initiatedTransfers KxTillTransfer[] @relation("InitiatedBy")
  approvedTransfers  KxTillTransfer[] @relation("ApprovedBy")
  rejectedTransfers  KxTillTransfer[] @relation("RejectedBy")
  completedTransfers KxTillTransfer[] @relation("CompletedBy")
  refundedSales     KxTillSale[] @relation("RefundedByUser")
  processedRefunds KxTillSaleRefund[] @relation("RefundProcessedBy")

  shiftsOwned         KxTillShift[] @relation("ShiftOwner")
  shiftsOpened        KxTillShift[] @relation("ShiftOpenedBy")
  shiftsClosed        KxTillShift[] @relation("ShiftClosedBy")
  shiftsHandoverReq   KxTillShift[] @relation("ShiftHandoverRequestedBy")
  shiftsHandoverRes   KxTillShift[] @relation("ShiftHandoverResolvedBy")
  shiftsVarianceRev   KxTillShift[] @relation("ShiftVarianceReviewedBy")

  creditLedger CustomerCreditLedger[]
  
  supportTickets          SupportTicket[] @relation("TicketReporter")
  assignedSupportTickets  SupportTicket[] @relation("TicketAssignee")

  @@map("users")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken  String    @unique
  expiresAt     DateTime
  userAgent     String?
  ipAddress     String?
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("sessions")
}

model VerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  type        String    // EMAIL_VERIFICATION, PASSWORD_RESET
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("verification_tokens")
}

// ============================================================
// ORGANIZATIONS & MEMBERSHIPS
// ============================================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  logo        String?
  logoPublicId String?
  email       String?
  phone       String?
  address     String?
  country     String
  currency    String   @default("KES")
  timezone    String   @default("Africa/Nairobi")
  auditLogRetention Int @default(45)
  isInternal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creditLedger CustomerCreditLedger[]

  memberships Membership[]
  invitations Invitation[]
  organizationProducts OrganizationProduct[]
  roles        Role[]
  subscriptions Subscription[]
  auditEvents  AuditEvent[]
  notifications Notification[]
  paymentConfig PaymentMerchantConfig?
  paymentTransactions PaymentTransaction[]
  paymentIPNRegistrations PaymentIPNRegistration[]
  kxtillProducts    KxTillProduct[]
  kxtillSales       KxTillSale[]
  kxtillRefunds KxTillSaleRefund[]
  kxtillShifts KxTillShift[]
  kxtillStoreSetting KxTillStoreSetting?
  branches       Branch[]
  supportTickets SupportTicket[]
  kxtillTransfers KxTillTransfer[]
  customers Customer[]

  @@index([ownerId])
  @@index([isInternal])
  @@index([slug])
  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?    @relation(fields: [roleId], references: [id])  // ← add this
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hasAllBranches Boolean  @default(false)
  branchAssignments BranchAssignment[]


  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ============================================================
// INVITATIONS
// ============================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invitation {
  id             String   @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  roleId         String?
  branchIds      String[]
  token          String   @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// PRODUCTS & ORGANIZATION PRODUCTS
// ============================================================

model Product {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  version     String   @default("1.0.0")
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationProducts OrganizationProduct[]

  @@map("products")
}

model OrganizationProduct {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  activatedAt    DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@index([productId])
  @@map("organization_products")
}

model TrialBurn {
  id             String   @id @default(uuid())
  ownerUserId    String
  productKey     String
  organizationId String
  burnedAt       DateTime @default(now())

  @@unique([ownerUserId, productKey])
  @@index([productKey])
  @@index([organizationId])
  @@map("trial_burns")
}

// ============================================================
// AUTHORIZATION
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  productKey  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([productKey])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================================
// SUBSCRIPTIONS & PLANS
// ============================================================

model Plan {
  id          String          @id @default(uuid())
  productKey  String
  key         String          // "professional", "business"
  name        String
  price       Int             // Whole currency amount: 699 = KES 699
  currency    String          @default("KES")
  interval    BillingInterval @default(MONTHLY)
  trialDays   Int             @default(21)
  features    String[]        // ["sales", "inventory"]
  limits      Json?           // { "users": 5, "products": 5000 }
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions Subscription[]

  @@unique([productKey, key])
  @@index([productKey])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productKey           String
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIAL)

  trialStart           DateTime?
  trialEnd             DateTime?
  graceStart           DateTime?
  graceEnd             DateTime?

  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime

  cancelledAt          DateTime?
  expiredAt            DateTime?

  // ✅ Add this field
  metadata             Json?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments             Payment[]

  @@unique([organizationId, productKey])
  @@index([organizationId])
  @@index([productKey])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount         Int           // Whole currency amount: 699 = KES 699
  currency       String        @default("KES")
  status         PaymentStatus
  method         String?       // mpesa, card, bank
  reference      String?
  metadata       Json?
  paidAt         DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_events")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  message        String
  channel        NotificationChannel @default(IN_APP)
  productKey     String?
  resource       String?
  resourceId     String?
  metadata       Json?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// PAYMENTS
// ============================================================

model PaymentMerchantConfig {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  provider        String   @default("PESAPAL")
  environment     String   // SANDBOX | LIVE
  consumerKey     String
  consumerSecret  String   // ENCRYPTED
  isActive        Boolean  @default(true)
  lastTestedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payment_merchant_configs")
}

model PaymentTransaction {
  id                  String   @id @default(uuid())
  organizationId      String
  productId           String?
  productReference    String?
  provider            String   @default("PESAPAL")
  merchantReference   String   @unique
  orderTrackingId     String?
  confirmationCode    String?
  amount              Decimal
  currency            String   @default("KES")
  description         String?
  status              String   @default("PENDING")
  paymentMethod       String?
  paymentAccount      String?
  redirectUrl         String?
  callbackUrl         String?
  cancellationUrl     String?
  notificationId      String?
  billingEmail        String?
  billingPhone        String?
  billingFirstName    String?
  billingLastName     String?
  billingCountry      String?
  billingLine1        String?
  billingCity         String?
  billingState        String?
  metadata            Json?
  ipnReceived         Boolean  @default(false)
  ipnPayload          Json?
  statusCode          Int?
  statusDescription   String?
  createdDate         DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderTrackingId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentIPNRegistration {
  id                String   @id @default(uuid())
  organizationId    String
  provider          String   @default("PESAPAL")
  ipnId             String
  url               String
  notificationType  String   // GET | POST
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, ipnId])
  @@index([organizationId])
  @@map("payment_ipn_registrations")
}


// ============================================================
// KXTILL - PRODUCTS, UNITS, PRICING & INVENTORY
// ============================================================

model KxTillProduct {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  category       String?
  taxRate        Decimal  @default(0)
  isActive       Boolean  @default(true)
  trackInventory Boolean  @default(true)

  baseUnitId     String?  @unique
  baseUnit       KxTillProductUnit? @relation("KxTillBaseUnit", fields: [baseUnitId], references: [id])
  units          KxTillProductUnit[] @relation("KxTillProductUnits")

  branchProducts KxTillBranchProduct[]
  saleItems      KxTillSaleItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cost           Decimal  @default(0)

  @@index([organizationId])
  @@index([sku])
  @@map("kxtill_products")
}


// ============================================================
// KXTILL - BRANCH PRODUCTS & INVENTORY
// ============================================================

model KxTillBranchProduct {
  id             String   @id @default(uuid())
  productId      String
  product        KxTillProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  

  displayName    String?
  description    String?
  isAvailable    Boolean  @default(true)
  stock          Decimal  @default(0)
  minStock       Decimal  @default(0)

  unitPrices     KxTillBranchProductUnitPrice[]
  saleItems      KxTillSaleItem[]
  sourceTransfers KxTillTransfer[] @relation("SourceTransfer")
  destTransfers   KxTillTransfer[] @relation("DestTransfer")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@map("kxtill_branch_products")
}

// ============================================================
// KXTILL - BRANCH PRODUCT UNIT PRICES
// ============================================================

model KxTillBranchProductUnitPrice {
  id               String   @id @default(uuid())
  branchProductId  String
  branchProduct    KxTillBranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
  unitId           String
  unit             KxTillProductUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  price            Decimal

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([branchProductId, unitId])
  @@index([branchProductId])
  @@index([unitId])
  @@map("kxtill_branch_product_unit_prices")
}

// ============================================================
// KXTILL - PRODUCT UNITS
// ============================================================

model KxTillProductUnit {
  id               String   @id @default(uuid())
  productId        String
  product          KxTillProduct @relation("KxTillProductUnits", fields: [productId], references: [id], onDelete: Cascade)
  name             String
  abbreviation     String
  unitType         String
  conversionQty    Decimal  @default(1)
  price            Decimal?
  allowFractional  Boolean  @default(false)
  barcode          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  saleItems        KxTillSaleItem[]
  branchUnitPrices KxTillBranchProductUnitPrice[]
  cost             Decimal?

  // ✅ Reverse relation for base unit (required by Prisma)
  baseForProduct   KxTillProduct? @relation("KxTillBaseUnit")

  @@unique([productId, name])
  @@unique([productId, abbreviation])
  @@index([productId])
  @@map("kxtill_product_units")
}

// ============================================================
// KXTILL - STOCK TRANSFERS
// ============================================================

model KxTillTransfer {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference      String   @unique

  sourceBranchProductId String
  sourceBranchProduct   KxTillBranchProduct @relation("SourceTransfer", fields: [sourceBranchProductId], references: [id], onDelete: Restrict)

  destBranchProductId   String
  destBranchProduct     KxTillBranchProduct @relation("DestTransfer", fields: [destBranchProductId], references: [id], onDelete: Restrict)

  quantitySent   Decimal
  quantityReceived Decimal?

  sourceStockBefore Decimal?
  sourceStockAfter  Decimal?

  destStockBefore   Decimal?
  destStockAfter    Decimal?

  status         String @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED, FAILED

  initiatedById  String
  initiatedBy    User @relation("InitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)

  notes          String?

  approvedById   String?
  approvedBy     User? @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt     DateTime?

  rejectedById   String?
  rejectedBy     User? @relation("RejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  rejectedAt     DateTime?
  rejectionReason String?

  completedById  String?
  completedBy    User? @relation("CompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  completedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([sourceBranchProductId])
  @@index([destBranchProductId])
  @@index([status])
  @@index([reference])
  @@map("kxtill_transfers")
}

// ============================================================
// KXTILL - SALES
// ============================================================

model KxTillSale {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  reference      String?
  customerName   String?

  clientSaleId   String? @unique
  deviceId       String?
  syncedAt       DateTime?

  refundedBy     String?
  refundedByUser User?    @relation("RefundedByUser", fields: [refundedBy], references: [id], onDelete: SetNull)
  refundedAt     DateTime?

  shiftId        String?
  shift          KxTillShift? @relation("ShiftSales", fields: [shiftId], references: [id], onDelete: SetNull)
  refundShiftId  String?
  refundShift    KxTillShift? @relation("RefundShift", fields: [refundShiftId], references: [id], onDelete: SetNull)

  subtotal       Decimal
  taxAmount      Decimal  @default(0)
  discount       Decimal  @default(0)
  totalAmount    Decimal
  refundedAmount Decimal  @default(0)
  status         String   @default("COMPLETED")
  paymentStatus  String   @default("PAID")
  customerId     String?
  customer       Customer? @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)

  items          KxTillSaleItem[]
  payments       KxTillSalePayment[]

  refunds        KxTillSaleRefund[] @relation("SaleRefunds")

  creditLedger CustomerCreditLedger[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([reference])
  @@index([clientSaleId])
  @@index([shiftId])
  @@index([refundShiftId])
  @@map("kxtill_sales")
}

// ============================================================
// KXTILL - SALE ITEMS
// ============================================================

model KxTillSaleItem {
  id             String   @id @default(uuid())
  saleId         String
  sale           KxTillSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId      String
  product        KxTillProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  branchProductId String
  branchProduct   KxTillBranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Restrict)

  unitId         String
  unit           KxTillProductUnit @relation(fields: [unitId], references: [id])

  unitName       String
  unitAbbrev     String
  unitType       String
  quantity       Decimal
  conversionQty  Decimal
  unitPrice      Decimal
  baseQuantity   Decimal

  taxRate        Decimal  @default(0)
  taxAmount      Decimal  @default(0)
  discount       Decimal  @default(0)
  total          Decimal

  refundItems    KxTillSaleRefundItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([branchProductId])
  @@index([unitId])
  @@map("kxtill_sale_items")
}

// ============================================================
// KXTILL - SALE PAYMENTS
// ============================================================

model KxTillSalePayment {
  id             String   @id @default(uuid())

  saleId         String
  sale            KxTillSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // CASH, MPESA, CARD, BANK, CREDIT, OTHER
  method         String

  amount         Decimal

  reference      String?

  metadata       Json?

  createdAt      DateTime @default(now())

  creditLedgerId String?
  creditLedger   CustomerCreditLedger? @relation("PaymentCreditLedger", fields: [creditLedgerId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([method])
  @@index([creditLedgerId])
  @@map("kxtill_sale_payments")
}

// ============================================================
// CUSTOMER CREDIT LEDGER (DENI)
// ============================================================

model CustomerCreditLedger {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // CHARGE, PAYMENT, ADJUSTMENT, REVERSAL
  type           String

  // Signed amount.
  amount         Decimal

  saleId         String?
  sale           KxTillSale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  shiftId        String?
  shift          KxTillShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // REVERSAL rows point back to the CHARGE they reverse.
  reversalOfId   String?
  reversalOf     CustomerCreditLedger? @relation("LedgerReversals", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals      CustomerCreditLedger[] @relation("LedgerReversals")

  note           String?

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt      DateTime @default(now())

  payments       KxTillSalePayment[] @relation("PaymentCreditLedger")

  @@index([organizationId])
  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([type])
  @@index([saleId])
  @@index([shiftId])
  @@index([reversalOfId])
  @@map("customer_credit_ledger")
}


// ============================================================
// KXTILL - SALE REFUNDS
// ============================================================

model KxTillSaleRefund {
  id             String   @id @default(uuid())
  reference      String   @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleId         String
  sale           KxTillSale @relation("SaleRefunds", fields: [saleId], references: [id], onDelete: Cascade)

  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  shiftId        String?
  shift          KxTillShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  userId         String
  user           User     @relation("RefundProcessedBy", fields: [userId], references: [id], onDelete: Restrict)

  totalAmount    Decimal
  cashAmount     Decimal  @default(0)
  creditAmount   Decimal  @default(0)
  otherAmount    Decimal  @default(0)

  reason         String?
  note           String?

  items          KxTillSaleRefundItem[]

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([saleId])
  @@index([branchId])
  @@index([shiftId])
  @@index([createdAt])
  @@map("kxtill_sale_refunds")
}

// ============================================================
// KXTILL - SALE REFUND ITEMS
// ============================================================

model KxTillSaleRefundItem {
  id          String   @id @default(uuid())

  refundId    String
  refund      KxTillSaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  saleItemId  String
  saleItem    KxTillSaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  quantity    Decimal
  unitPrice   Decimal
  total       Decimal

  createdAt   DateTime @default(now())

  @@index([refundId])
  @@index([saleItemId])
  @@map("kxtill_sale_refund_items")
}

// ============================================================
// KXTILL - STORE SETTINGS
// ============================================================

model KxTillStoreSetting {
  id             String   @id @default(uuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  shopName       String?
  shopPhone      String?
  shopAddress    String?
  shopEmail      String?
  taxNumber      String?

  receiptFooter  String?
  receiptHeader  String?
  receiptTemplate String @default("classic")  

  showTax        Boolean  @default(false)
  showCustomer   Boolean  @default(false)


  showCashier    Boolean  @default(true)
  currency       String?  // Override org currency
  timezone       String?  // Override org timezone
  decimalPlaces  Int      @default(2)
  defaultPaymentMethod String @default("CASH")

  // Notification settings
  lowStockAlerts      Boolean @default(true)
  dailySalesReport    Boolean @default(false)
  weeklySummary       Boolean @default(true)
  refundNotifications Boolean @default(true)

  // Security settings
  sessionTimeout       Int  @default(30)
  requirePinForRefund  Boolean @default(true)
  auditLogRetention    Int  @default(90)

  // Branch settings
  allowBranchSwitch Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("kxtill_store_settings")
}

// ============================================================
// BRANCH MANAGEMENT
// ============================================================

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  code           String
  address        String?
  phone          String?
  email          String?

  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)


  creditLedger CustomerCreditLedger[]
  assignments    BranchAssignment[]
  sales          KxTillSale[]
  kxtillRefunds KxTillSaleRefund[]
  branchProducts KxTillBranchProduct[]

  kxtillBranchSetting KxTillBranchSetting?
  kxtillShifts        KxTillShift[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

model BranchAssignment {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([membershipId, branchId])
  @@index([membershipId])
  @@index([branchId])
  @@map("branch_assignments")
}

// ============================================================
// SUPPORT - TICKETS & CATEGORIES
// ============================================================

model SupportCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     SupportTicket[]

  @@map("support_categories")
}

model SupportTicket {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("TicketReporter", fields: [userId], references: [id], onDelete: Cascade)

  categoryId     String
  category       SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title          String
  description    String
  priority       String   @default("MEDIUM")
  status         String   @default("OPEN")
  productKey     String?

  // ============================================================
  // CONTEXT — generic scope tag (branch today, queue/site in KxHelp)
  // ============================================================
  contextId      String?
  contextType    String?  // 'branch' | 'site' | 'queue' (future)

  // ============================================================
  // ASSIGNMENT
  // ============================================================
  assigneeId     String?
  assignee       User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // ============================================================
  // ESCALATION — generic, product-agnostic (KxHelp-ready)
  // ============================================================
  escalatedAt      DateTime?
  escalatedById    String?
  escalatedToId    String?  // user id, team id, vendor id
  escalatedToType  String?  // 'user' | 'team' | 'vendor'

  // ============================================================
  // RESOLUTION
  // ============================================================
  resolutionNote   String?
  resolvedById     String?

  messages       SupportMessage[]

  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@index([categoryId])
  @@index([productKey])
  @@index([contextId])
  @@index([contextType])
  @@map("support_tickets")
}

model SupportMessage {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String
  isInternal     Boolean  @default(false)
  attachments    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticketId])
  @@map("support_messages")
}

model SupportGuide {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  summary      String
  body         String?
  url          String?
  category     String
  productKey   String?
  order        Int      @default(0)
  isPublished  Boolean  @default(true)

  authorId     String?
  author       User?    @relation("GuideAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([productKey])
  @@index([isPublished])
  @@map("support_guides")
}

// ============================================================
// SOCIAL AUTH
// ============================================================

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // google, github, apple, facebook
  providerId  String
  email       String?
  name        String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
  @@map("social_accounts")
}

// ============================================================
// CUSTOMERS (Platform-level)
// ============================================================

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  customerType   String   @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS

  phone          String?
  email          String?

  taxNumber      String?
  companyName    String?

  address        String?
  city           String?
  country        String?

  source         String? // WALK_IN, REFERRAL, FACEBOOK, WEBSITE, WHATSAPP
  createdByProduct String? 

  notes          String?
  isActive       Boolean  @default(true)

  creditLimit  Decimal?
  creditLedger CustomerCreditLedger[]

  kxtillSales KxTillSale[] @relation("CustomerSales")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([phone])
  @@index([email])
  @@unique([organizationId, phone])
  @@map("customers")
}

// ============================================================
// KXTILL - SHIFT SETTINGS (per branch)
// ============================================================

model KxTillBranchSetting {
  id                String   @id @default(uuid())
  branchId          String   @unique
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  shiftsEnabled     Boolean  @default(false)
  varianceThreshold Decimal  @default(50)

  creditEnabled Boolean @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("kxtill_branch_settings")
}

// ============================================================
// KXTILL - SHIFTS
// ============================================================

model KxTillShift {
  id                    String   @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId                String
  user                  User     @relation("ShiftOwner", fields: [userId], references: [id], onDelete: Restrict)

  tillId                String?
  status                String   @default("OPEN")
  closureType           String?

  openingFloat          Decimal
  declaredCash          Decimal?
  expectedCash          Decimal?
  variance              Decimal?

  openedAt              DateTime @default(now())
  closedAt              DateTime?

  openedById            String
  openedBy              User     @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById            String?
  closedBy              User?    @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  handoverRequestedById String?
  handoverRequestedBy   User?    @relation("ShiftHandoverRequestedBy", fields: [handoverRequestedById], references: [id], onDelete: SetNull)
  handoverResolvedById  String?
  handoverResolvedBy    User?    @relation("ShiftHandoverResolvedBy", fields: [handoverResolvedById], references: [id], onDelete: SetNull)
  handoverResolvedAt    DateTime?
  handoverNote          String?

  varianceReviewedById  String?
  varianceReviewedBy    User?    @relation("ShiftVarianceReviewedBy", fields: [varianceReviewedById], references: [id], onDelete: SetNull)
  varianceReviewedAt    DateTime?
  varianceNote          String?

  sales                 KxTillSale[] @relation("ShiftSales")

  refunds               KxTillSale[] @relation("RefundShift")

  creditLedger CustomerCreditLedger[]
  processedRefunds KxTillSaleRefund[]

  deletedAt             DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([branchId, status])
  @@map("kxtill_shifts")
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  newsletter   Boolean  @default(false)   // general KXBYTE news
  waitlists    String[] @default([])      // ['kxinvoice', 'kxcrm']
  source       String?                    // 'kxbyte.co.ke' | 'suite' | etc.
  ipAddress    String?
  userAgent    String?
  unsubscribedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([newsletter])
  @@map("subscribers")
}